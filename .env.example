# Copy to .env and fill in. Never commit a filled .env.

# Server port (Railway sets PORT automatically — leave default).
PORT=3000

# Public https URL of this deployment, no trailing slash.
# Used for the post-checkout redirect and shown at boot for webhook setup.
BASE_URL=https://your-site.up.railway.app

# Whop dashboard -> Developer -> API keys.
WHOP_API_KEY=

# Your Whop company/business account ID (starts with biz_).
# This is the account the one-time checkout charges.
WHOP_ACCOUNT_ID=biz_

# Whop dashboard -> Webhooks -> your endpoint -> reveal secret (starts with ws_).
# Used to verify incoming webhook signatures. Required in production.
WHOP_WEBHOOK_SECRET=ws_
